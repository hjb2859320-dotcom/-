{
  "entities": {
    "User": {
      "title": "User",
      "description": "Employee or administrator profile and status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Auth UID" },
        "name": { "type": "string", "description": "Full name of the employee" },
        "employeeNumber": { "type": "string", "description": "Employee ID number (사번)" },
        "team": { "type": "string", "description": "Team name (소속 팀)" },
        "department": { "type": "string", "description": "Department/Team legacy" },
        "assignedSite": { "type": "string", "description": "Assigned pre-sale site (담당 분양 현장)" },
        "position": { "type": "string", "description": "Job title / position (대표, 이사, 본부장, 실장, 과장, 대리, 주임, 관리자)" },
        "phoneNumber": { "type": "string", "description": "Contact phone number" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "enum": ["admin", "employee"], "description": "Account role" },
        "status": { "type": "string", "enum": ["pending", "active", "rejected", "deactivated"], "description": "Approval and account status" },
        "createdAt": { "type": "string", "description": "Creation ISO date string" },
        "updatedAt": { "type": "string", "description": "Last update ISO date string" }
      },
      "required": ["uid", "name", "employeeNumber", "team", "assignedSite", "position", "email", "role", "status", "createdAt"]
    },
    "Team": {
      "title": "Team",
      "description": "Company organizational team",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Team identifier" },
        "name": { "type": "string", "description": "Team name" },
        "description": { "type": "string", "description": "Team description" },
        "createdAt": { "type": "string", "description": "Created date" }
      },
      "required": ["id", "name"]
    },
    "Performance": {
      "title": "Performance",
      "description": "Employee sales performance record (contract or visitor)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Performance document ID" },
        "employeeId": { "type": "string", "description": "Employee UID who created the record" },
        "employeeName": { "type": "string", "description": "Employee name" },
        "employeeNumber": { "type": "string", "description": "Employee ID number (사번)" },
        "team": { "type": "string", "description": "Team name" },
        "siteName": { "type": "string", "description": "Pre-sale site name (분양 현장명)" },
        "type": { "type": "string", "enum": ["contract", "visitor"], "description": "Performance type" },
        "date": { "type": "string", "description": "Event occurrence date YYYY-MM-DD" },
        "yearMonth": { "type": "string", "description": "Year and month YYYY-MM for indexing" },
        "contractIdentifier": { "type": "string", "description": "Building/Unit number or contract code" },
        "contractCount": { "type": "number", "description": "Number of contracts" },
        "visitorCount": { "type": "number", "description": "Number of visitors" },
        "visitorType": { "type": "string", "enum": ["new", "revisit"], "description": "Visitor category" },
        "funnelSource": { "type": "string", "description": "Visitor acquisition channel" },
        "status": { "type": "string", "enum": ["completed", "cancelled"], "description": "Contract/performance status" },
        "memo": { "type": "string", "description": "Notes or remarks" },
        "createdAt": { "type": "string", "description": "Record creation timestamp" },
        "updatedAt": { "type": "string", "description": "Record update timestamp" }
      },
      "required": ["id", "employeeId", "employeeName", "siteName", "type", "date", "yearMonth", "status", "createdAt"]
    },
    "ResourceItem": {
      "title": "ResourceItem",
      "description": "Shared reference document or form in company resources",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Resource ID" },
        "title": { "type": "string", "description": "Resource title" },
        "category": { "type": "string", "description": "Category" },
        "description": { "type": "string", "description": "Resource description" },
        "fileName": { "type": "string", "description": "Attachment file name" },
        "fileSize": { "type": "string", "description": "Attachment file size" },
        "authorId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "description": "Author name" },
        "authorTeam": { "type": "string", "description": "Author team" },
        "authorPosition": { "type": "string", "description": "Author position" },
        "downloadCount": { "type": "number", "description": "Download counter" },
        "createdAt": { "type": "string", "description": "Created ISO timestamp" }
      },
      "required": ["id", "title", "category", "description", "authorId", "authorName", "createdAt"]
    },
    "PersonalSchedule": {
      "title": "PersonalSchedule",
      "description": "Employee personal private calendar item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Schedule item ID" },
        "employeeId": { "type": "string", "description": "Owner employee UID" },
        "date": { "type": "string", "description": "Schedule date YYYY-MM-DD" },
        "time": { "type": "string", "description": "Schedule time HH:mm" },
        "title": { "type": "string", "description": "Schedule title" },
        "category": { "type": "string", "description": "Schedule category" },
        "location": { "type": "string", "description": "Location or model house" },
        "memo": { "type": "string", "description": "Private memo" },
        "completed": { "type": "boolean", "description": "Completion toggle" },
        "createdAt": { "type": "string", "description": "Created timestamp" }
      },
      "required": ["id", "employeeId", "date", "title", "category", "completed", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Pre-sale site (분양 현장)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Project ID" },
        "name": { "type": "string", "description": "Site name" },
        "location": { "type": "string", "description": "Site location" },
        "status": { "type": "string", "enum": ["active", "completed", "upcoming"], "description": "Site status" }
      },
      "required": ["id", "name", "status"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Company announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Notice ID" },
        "title": { "type": "string", "description": "Notice title" },
        "content": { "type": "string", "description": "Notice detailed content" },
        "isImportant": { "type": "boolean", "description": "Pinned notice" },
        "authorId": { "type": "string", "description": "Author UID" },
        "authorName": { "type": "string", "description": "Author display name" },
        "createdAt": { "type": "string", "description": "Created timestamp" }
      },
      "required": ["id", "title", "content", "isImportant", "authorId", "authorName", "createdAt"]
    },
    "Event": {
      "title": "Event",
      "description": "Company promotional events",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Event ID" },
        "title": { "type": "string", "description": "Event title" },
        "description": { "type": "string", "description": "Event description" },
        "startDate": { "type": "string", "description": "Start date YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "End date YYYY-MM-DD" },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "ended"], "description": "Event status" },
        "createdAt": { "type": "string", "description": "Created timestamp" }
      },
      "required": ["id", "title", "description", "startDate", "endDate", "status", "createdAt"]
    },
    "EmployeeOfTheMonth": {
      "title": "EmployeeOfTheMonth",
      "description": "Selected employee of the month award",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Award ID" },
        "yearMonth": { "type": "string", "description": "Target year-month" },
        "employeeId": { "type": "string", "description": "Awarded employee UID" },
        "employeeName": { "type": "string", "description": "Employee name" },
        "team": { "type": "string", "description": "Team name" },
        "assignedSite": { "type": "string", "description": "Assigned site" },
        "criteriaCategory": { "type": "string", "description": "Award category" },
        "reason": { "type": "string", "description": "Reason" },
        "isPublic": { "type": "boolean", "description": "Public toggle" }
      },
      "required": ["id", "yearMonth", "employeeId", "employeeName", "team", "criteriaCategory", "reason", "isPublic"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and approval status"
    },
    "/teams/{teamId}": {
      "schema": "Team",
      "description": "Company teams managed by admin"
    },
    "/performances/{performanceId}": {
      "schema": "Performance",
      "description": "Employee contracts and visitor performance entries"
    },
    "/resources/{resourceId}": {
      "schema": "ResourceItem",
      "description": "Shared company document resources"
    },
    "/schedules/{scheduleId}": {
      "schema": "PersonalSchedule",
      "description": "Private personal schedule calendar items"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Pre-sale real estate project sites"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Official company notices"
    },
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Internal and promotional events"
    },
    "/employee_of_the_month/{awardId}": {
      "schema": "EmployeeOfTheMonth",
      "description": "Monthly star employee recognitions"
    }
  }
}
