rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hjb2859320@gmail.com'
      );
    }

    function isExecutiveOrAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isExecutiveOrAdmin();
    }

    // Teams collection
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow write: if isExecutiveOrAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // For 조직도 (Organization Chart)
      
      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() && (
        isExecutiveOrAdmin() ||
        (request.auth.uid == userId)
      );

      allow delete: if isExecutiveOrAdmin();
    }

    // Performance records
    match /performances/{performanceId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isExecutiveOrAdmin();
    }

    // Audit logs
    match /performance_audit_logs/{logId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Resources (자료실: 모든 승인 직원 작성 및 조회 가능)
    match /resources/{resourceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Personal Schedules (개인일정표: 본인만 읽고 쓸 수 있음)
    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && resource.data.employeeId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.employeeId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.employeeId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.employeeId == request.auth.uid;
    }

    // Pre-sale sites (Projects)
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow write: if isExecutiveOrAdmin();
    }

    // Notices
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow write: if isExecutiveOrAdmin();
    }

    // Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isExecutiveOrAdmin();
    }

    // Employee of the Month
    match /employee_of_the_month/{awardId} {
      allow read: if isSignedIn();
      allow write: if isExecutiveOrAdmin();
    }
  }
}
